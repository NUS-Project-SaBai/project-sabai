NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

NODE_ENV=development
SUPABASE_SECRET_KEY=your-secret-key-here
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# CLOUDINARY
# Base URL for serving images: https://res.cloudinary.com/YOUR_CLOUD_NAME/
CLOUDINARY_URL_PREFIX=https://res.cloudinary.com/your-cloud-name
# API credentials: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://123456789012345:abcdefghijklmnopqrstuvwxyz123456@your-cloud-name 

# AWS (For facial recognition using Rekognition)
AWS_ACCESS_KEY_ID=XXXXXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AWS_REGION=
COLLECTION_ID=

# APP MODE
# ONLINE: patient images use Cloudinary and face recognition uses AWS Rekognition (above).
# OFFLINE: patient images use local RustFS storage and face recognition uses the local face service.
# Start both with `docker compose up -d --build` from the repo root, which reads STORAGE_* and
# FACE_SERVICE_API_KEY from this file.
APP_MODE=ONLINE
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_ACCESS_KEY=
# At least 8 characters
STORAGE_SECRET_KEY=
STORAGE_BUCKET=sabai
FACE_SERVICE_URL=http://127.0.0.1:5080
# At least 32 characters, e.g. from `openssl rand -hex 32`
FACE_SERVICE_API_KEY=
